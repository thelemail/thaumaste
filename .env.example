# Required
THAUMASTE_POSTGRES_USER=thaumaste
THAUMASTE_POSTGRES_PASSWORD=thaumaste
THAUMASTE_POSTGRES_DB=thaumaste

# Optional — defaults shown
THAUMASTE_APP_ENV=local

THAUMASTE_SERVER_ADDR=:8008
THAUMASTE_SERVER_READ_TIMEOUT=15s
THAUMASTE_SERVER_WRITE_TIMEOUT=30s
THAUMASTE_SERVER_SHUTDOWN_TIMEOUT=30s

THAUMASTE_HEALTH_ADDR=:8009
THAUMASTE_HEALTH_DRAIN_DELAY=5s

THAUMASTE_POSTGRES_HOST=127.0.0.1
THAUMASTE_POSTGRES_PORT=5435
THAUMASTE_POSTGRES_SSLMODE=disable
THAUMASTE_POSTGRES_MAX_OPEN_CONNS=25
THAUMASTE_POSTGRES_MAX_IDLE_CONNS=5
THAUMASTE_POSTGRES_CONN_MAX_LIFETIME=30m
THAUMASTE_POSTGRES_STATEMENT_TIMEOUT=15s
THAUMASTE_POSTGRES_LOCK_TIMEOUT=5s
THAUMASTE_POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT=30s
THAUMASTE_POSTGRES_MIGRATE_ON_START=true

THAUMASTE_LOG_LEVEL=info
THAUMASTE_LOG_FORMAT=json
