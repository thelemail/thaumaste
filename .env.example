# Required
THAUMASTE_POSTGRES_USER=thaumaste
THAUMASTE_POSTGRES_PASSWORD=thaumaste
THAUMASTE_POSTGRES_DB=thaumaste

# 32 bytes, base64. Generate with: openssl rand -base64 32
# Lose this and every tenant's signing key becomes unreadable.
THAUMASTE_SIGNING_MASTER_KEY=

# Optional — defaults shown
THAUMASTE_APP_ENV=local

THAUMASTE_SERVER_INSTANCE_NAME=default
THAUMASTE_SERVER_ADDR=:8008
THAUMASTE_SERVER_READ_TIMEOUT=15s
THAUMASTE_SERVER_WRITE_TIMEOUT=30s
THAUMASTE_SERVER_SHUTDOWN_TIMEOUT=30s
THAUMASTE_SERVER_PUBLIC_SCHEME=https

THAUMASTE_HEALTH_ADDR=:8009
THAUMASTE_HEALTH_DRAIN_DELAY=5s

THAUMASTE_POSTGRES_HOST=127.0.0.1
THAUMASTE_POSTGRES_PORT=5435
THAUMASTE_POSTGRES_SSLMODE=disable
THAUMASTE_POSTGRES_MAX_OPEN_CONNS=25
THAUMASTE_POSTGRES_MAX_IDLE_CONNS=5
THAUMASTE_POSTGRES_CONN_MAX_LIFETIME=30m
THAUMASTE_POSTGRES_STATEMENT_TIMEOUT=15s
THAUMASTE_POSTGRES_LOCK_TIMEOUT=5s
THAUMASTE_POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT=30s
THAUMASTE_POSTGRES_MIGRATE_ON_START=true

THAUMASTE_VALKEY_ADDRS=127.0.0.1:6382
THAUMASTE_VALKEY_DB=0
THAUMASTE_VALKEY_KEY_PREFIX=thaumaste
THAUMASTE_VALKEY_LOCK_VALIDITY=10s

THAUMASTE_SIGNING_KEY_VALIDITY=24h
# Set only when changing the master key, then run: thaumaste keys reseal
THAUMASTE_SIGNING_NEXT_MASTER_KEY=

THAUMASTE_AUTH_ACCESS_TOKEN_TTL=1h
THAUMASTE_AUTH_REFRESH_TOKEN_TTL=720h
THAUMASTE_AUTH_SESSION_TTL=15m
THAUMASTE_AUTH_MAX_FAILURES=10
THAUMASTE_AUTH_FAILURE_WINDOW=15m
THAUMASTE_AUTH_LOCK_FOR=15m
# Public half of the key an external identity provider signs assertions with, base64.
# Empty leaves the server standing alone on its own credential store.
THAUMASTE_AUTH_ASSERTION_KEY=

THAUMASTE_LIMITS_SEND_PER_USER=10
THAUMASTE_LIMITS_SEND_PER_ROOM=60
THAUMASTE_LIMITS_SEND_PER_TENANT=600
THAUMASTE_LIMITS_SEND_WINDOW=5s
THAUMASTE_LIMITS_TXN_RETENTION=24h
THAUMASTE_LIMITS_TXN_SWEEP_EVERY=1h

THAUMASTE_LOG_LEVEL=info
THAUMASTE_LOG_FORMAT=json
